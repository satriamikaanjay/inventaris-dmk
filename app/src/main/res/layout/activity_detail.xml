<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    tools:context=".DetailActivity">

    <!-- Header Biru Atas -->
    <View
        android:id="@+id/viewHeader"
        android:layout_width="0dp"
        android:layout_height="90dp"
        android:background="#1C4E8F"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Tombol Kembali / Panah & Judul -->
    <ImageView
        android:id="@+id/ivBack"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="16dp"
        android:src="@android:drawable/ic_menu_revert"
        app:tint="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="@id/tvAppTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvAppTitle" />

    <TextView
        android:id="@+id/tvAppTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="16dp"
        android:text="Detail Barang"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/ivBack"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Ikon Notifikasi di Header Kanan -->
    <ImageView
        android:id="@+id/ivNotification"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginEnd="16dp"
        android:src="@android:drawable/ic_dialog_email"
        app:tint="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="@id/tvAppTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvAppTitle" />

    <!-- Konten Utama Detail (CardView Melayang) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardDetailContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="20dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/viewHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Bagian Atas Card: Ikon Besar & Nama Barang -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivItemDetailIcon"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="#E8F1FC"
                    android:padding="12dp"
                    android:src="@android:drawable/ic_menu_slideshow"
                    app:tint="#1C4E8F" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvItemName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Laptop ASUS ZenBook 14"
                        android:textColor="#000000"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvItemCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Kode: IT-001"
                        android:textColor="#666666"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvItemStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="#E8F5E9"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:text="TERSEDIA: 5 UNIT"
                        android:textColor="#2E7D32"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Garis Pembatas Tipis -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:background="#E0E0E0" />

            <!-- Informasi Lokasi & Kategori -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lokasi Penyimpanan"
                android:textColor="#848484"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvItemLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Gudang A - Rak 3"
                android:textColor="#000000"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Kategori"
                android:textColor="#848484"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvItemCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Elektronik &amp; IT"
                android:textColor="#000000"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- ========================================== -->
            <!-- TAMBAHAN TOMBOL PENGAJUAN DI BAWAH KATEGORI  -->
            <!-- ========================================== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Jenis Pengajuan"
                android:textColor="#848484"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical">

                <!-- Tombol 1: Pengajuan Peminjaman (Aktif / Warna Biru)[cite: 2] -->
                <Button
                    android:id="@+id/btnPengajuanPeminjaman"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginBottom="6dp"
                    android:backgroundTint="#1C4E8F"
                    android:drawableStart="@android:drawable/presence_online"
                    android:drawablePadding="10dp"
                    android:gravity="center_vertical|start"
                    android:paddingStart="14dp"
                    android:text="Pengajuan Peminjaman"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Tombol 2: Pengajuan Pengembalian[cite: 2] -->
                <Button
                    android:id="@+id/btnPengajuanPengembalian"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginBottom="6dp"
                    android:backgroundTint="#F8F9FA"
                    android:drawableStart="@android:drawable/presence_invisible"
                    android:drawablePadding="10dp"
                    android:gravity="center_vertical|start"
                    android:paddingStart="14dp"
                    android:text="Pengajuan Pengembalian"
                    android:textAllCaps="false"
                    android:textColor="#333333"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:strokeColor="#E0E0E0"
                    app:strokeWidth="1dp" />

                <!-- Tombol 3: Pengajuan Peleburan[cite: 2] -->
                <Button
                    android:id="@+id/btnPengajuanPeleburan"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginBottom="6dp"
                    android:backgroundTint="#F8F9FA"
                    android:drawableStart="@android:drawable/presence_invisible"
                    android:drawablePadding="10dp"
                    android:gravity="center_vertical|start"
                    android:paddingStart="14dp"
                    android:text="Pengajuan Peleburan"
                    android:textAllCaps="false"
                    android:textColor="#333333"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:strokeColor="#E0E0E0"
                    app:strokeWidth="1dp" />

                <!-- Tombol 4: Pengajuan Servis[cite: 2] -->
                <Button
                    android:id="@+id/btnPengajuanServis"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:backgroundTint="#F8F9FA"
                    android:drawableStart="@android:drawable/presence_invisible"
                    android:drawablePadding="10dp"
                    android:gravity="center_vertical|start"
                    android:paddingStart="14dp"
                    android:text="Pengajuan Servis"
                    android:textAllCaps="false"
                    android:textColor="#333333"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:strokeColor="#E0E0E0"
                    app:strokeWidth="1dp" />
            </LinearLayout>
            <!-- ========================================== -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Spesifikasi Lengkap"
                android:textColor="#848484"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvItemSpecs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Intel Core i7 11th Gen, 16GB LPDDR4X RAM, 512GB NVMe PCIe SSD, Layar 14 inch FHD IPS."
                android:textColor="#333333"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Tombol Aksi di Bagian Bawah -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:weightSum="2">

        <Button
            android:id="@+id/btnKembali"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:backgroundTint="#EBF0FA"
            android:text="Kembali"
            android:textColor="#1C4E8F"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPinjamSekarang"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:backgroundTint="#1C4E8F"
            android:text="Ajukan"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>