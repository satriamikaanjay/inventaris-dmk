<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Header Dialog Form Pengajuan Lainnya -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_green"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:text="PENGAJUAN LAINNYA (DATA STOK)"
                        android:textColor="#047857"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Ajukan Barang di Luar Stok"
                        android:textColor="#0F172A"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Gunakan form ini untuk mengajukan barang yang belum tersedia di daftar Data Stok."
                        android:textColor="#64748B"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnCloseFormLainnyaStok"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_circle_gray"
                    android:gravity="center"
                    android:text="✕"
                    android:textColor="#475569"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 1. Nama Pemohon (Otomatis dari Akun) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Nama Pemohon (Otomatis dari Akun)"
                android:textColor="#0F172A"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etLainnyaNamaPemohon"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_rounded"
                android:enabled="false"
                android:focusable="false"
                android:paddingHorizontal="14dp"
                android:text="Dewi"
                android:textColor="#1E293B"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="✓ Terisi otomatis sesuai akun yang sedang login"
                android:textColor="#2E7D32"
                android:textSize="10.5sp" />

            <!-- 2. Nama Barang yang Diajukan -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Nama Barang yang Diajukan *"
                android:textColor="#0F172A"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etLainnyaNamaBarang"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_rounded"
                android:hint="Ketik nama barang yang belum ada di stok..."
                android:inputType="textCapWords"
                android:paddingHorizontal="14dp"
                android:singleLine="true"
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8"
                android:textSize="13.5sp" />

            <!-- 3. Jumlah & Satuan Barang -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:weightSum="2">

                <!-- Kolom Jumlah -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Jumlah Barang *"
                        android:textColor="#0F172A"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnMinusLainnyaJumlah"
                            android:layout_width="38dp"
                            android:layout_height="46dp"
                            android:backgroundTint="#E2E8F0"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp"
                            android:text="−"
                            android:textColor="#0F172A"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/etLainnyaJumlah"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_marginHorizontal="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_input_rounded"
                            android:gravity="center"
                            android:inputType="number"
                            android:text="1"
                            android:textColor="#0F172A"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnPlusLainnyaJumlah"
                            android:layout_width="38dp"
                            android:layout_height="46dp"
                            android:backgroundTint="#047857"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp"
                            android:text="+"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Kolom Satuan -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Satuan *"
                        android:textColor="#0F172A"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input_rounded"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="6dp">

                        <Spinner
                            android:id="@+id/spinnerLainnyaSatuan"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 4. Harga / Estimasi Harga (Rp) (Opsional) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Harga / Estimasi Harga Barang (Rp) (Opsional)"
                android:textColor="#0F172A"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_rounded"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rp"
                    android:textColor="#047857"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etLainnyaHarga"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Contoh: 50000 (opsional)"
                    android:inputType="number"
                    android:singleLine="true"
                    android:textColor="#0F172A"
                    android:textColorHint="#94A3B8"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvLainnyaFormatHarga"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Opsional • Kosongkan jika harga belum diketahui"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- 5. Upload File / Lampiran (Opsional - Mendukung Semua File) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Upload File / Lampiran (Opsional)"
                android:textColor="#0F172A"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layoutUploadFileLainnya"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_rounded"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_badge_green"
                    android:padding="7dp"
                    android:src="@android:drawable/ic_menu_upload"
                    app:tint="#047857" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvSelectedFileNameLainnya"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="middle"
                        android:singleLine="true"
                        android:text="Belum ada file dipilih (Opsional)"
                        android:textColor="#0F172A"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSelectedFileInfoLainnya"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Mendukung semua jenis file (Foto, PDF, Dokumen, Excel, dll)"
                        android:textColor="#64748B"
                        android:textSize="10.5sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnPilihFileLainnya"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="#ECFDF5"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Pilih File"
                    android:textAllCaps="false"
                    android:textColor="#047857"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutFileActionsLainnya"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <Button
                    android:id="@+id/btnLihatFileLainnya"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:backgroundTint="#ECFDF5"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="👁️ Lihat File"
                    android:textAllCaps="false"
                    android:textColor="#047857"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnHapusFileLainnya"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="4dp"
                    android:backgroundTint="#FFEBEE"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="✕ Hapus"
                    android:textAllCaps="false"
                    android:textColor="#C62828"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 6. Textbox Deskripsi / Keterangan (Opsional) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Deskripsi / Keterangan (Opsional)"
                android:textColor="#0F172A"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etLainnyaDeskripsi"
                android:layout_width="match_parent"
                android:layout_height="84dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_rounded"
                android:gravity="top|start"
                android:hint="Tuliskan alasan pengajuan atau spesifikasi barang (opsional)..."
                android:inputType="textMultiLine|textCapSentences"
                android:padding="12dp"
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8"
                android:textSize="13sp" />

            <!-- Tombol Aksi: Batal & Kirim -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnBatalLainnyaStok"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="#F1F5F9"
                    android:text="Batal"
                    android:textAllCaps="false"
                    android:textColor="#475569"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnSubmitLainnyaStok"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1.5"
                    android:backgroundTint="#047857"
                    android:text="Ajukan Lainnya"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</androidx.cardview.widget.CardView>
